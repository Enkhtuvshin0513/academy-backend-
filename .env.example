# ─── App ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database (MongoDB) ────────────────────────────────────────────────────
# MongoDB Atlas (cloud):
DATABASE_URL="mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/academy?retryWrites=true&w=majority"

# MongoDB local:
# DATABASE_URL="mongodb://localhost:27017/academy"

# ─── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-random-32-char-string-in-production"
JWT_EXPIRES_IN=7d
